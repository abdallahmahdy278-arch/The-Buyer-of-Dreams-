---
const { title = "بائعة الأحلام" } = Astro.props;
---
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Aref+Ruqaa:wght@400;700&family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-paper text-ink font-tajawal min-h-screen flex flex-col">
    <header class="border-b border-gold/30 p-6 text-center">
      <h1 class="font-ruqaa text-4xl text-bordeaux">بائعة الأحلام</h1>
    </header>
    <main class="flex-grow container mx-auto px-4 py-8">
      <slot />
    </main>
    <footer class="border-t border-gold/30 p-4 text-center text-sm opacity-70">
      جميع الحقوق محفوظة © 2026
    </footer>
  </body>
</html>